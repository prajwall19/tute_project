rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'citizen';
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 5
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 50
                    && (!('imageDataUrl' in request.resource.data) || request.resource.data.imageDataUrl == null || (request.resource.data.imageDataUrl is string && request.resource.data.imageDataUrl.size() <= 900000));
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && (request.auth.token.email == 'prajwal@gmail.com'
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                    && request.resource.data.status in ['submitted', 'acknowledged', 'in_progress', 'resolved'];
    }
  }
}
